# Browser-public Firebase web-app configuration for the selected environment.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Leave blank in staging/production to use same-origin /api/v1.
VITE_API_BASE_URL=
VITE_CDN_BASE_URL=
VITE_PORTAL_BASE_URL=
VITE_EXAM_BASE_URL=
VITE_VENDOR_BASE_URL=

# Explicit local fixture opt-in. CI and release artifacts must use live.
VITE_DATA_MODE=fixture

# Student is hosted below /student/ in test, staging, and production.
VITE_BASE_PATH=/student/

# CI-generated public release metadata.
VITE_RELEASE_ID=
VITE_RELEASE_COMMIT_SHA=
VITE_RELEASE_BUILT_AT=
