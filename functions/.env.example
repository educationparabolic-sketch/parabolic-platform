# Application-owned runtime configuration. Values shown here are safe local
# examples only; staging/production values come from deployment configuration.
PROJECT_ID=demo-parabolic-local
NODE_ENV=development
APP_BASE_URL=http://localhost:5173
EXAM_BASE_URL=http://localhost:4173
VENDOR_BASE_URL=http://localhost:6173
CDN_BASE_URL=http://localhost:9199/cdn
QUESTION_ASSETS_BUCKET=demo-parabolic-local-question-assets
REPORTS_BUCKET=demo-parabolic-local-reports

# CI-generated release metadata. Required for test/staging/production artifacts.
RELEASE_ID=
RELEASE_COMMIT_SHA=
RELEASE_BUILT_AT=

# Optional operational policy overrides.
FAILURE_RECOVERY_USE_CLOUD_TASKS=false
BIGQUERY_ARCHIVE_LOCATION=asia-south1
RETENTION_AUDIT_LOG_DAYS=2555
RETENTION_BILLING_RECORD_DAYS=2555
RETENTION_EMAIL_LOG_DAYS=365
RETENTION_MAX_DOCUMENTS_PER_RUN=200
RETENTION_SESSION_ARCHIVE_GRACE_DAYS=30
RETENTION_SESSION_ARCHIVE_DAYS=1825

# Required only when signed CDN URLs are enabled. The key value is a secret.
CDN_SIGNED_URL_KEY_NAME=
CDN_SIGNED_URL_KEY_VALUE=

# Local development/test secrets are loaded from an ignored environment only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
AI_API_KEY=
EMAIL_PROVIDER_KEY=

# Production secret references. Never put secret payloads in these fields.
# Values may be a secret ID (for the current project) or a full
# projects/<project>/secrets/<secret>/versions/<version> resource name.
STRIPE_SECRET_KEY_SECRET_NAME=STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET_NAME=STRIPE_WEBHOOK_SECRET
AI_API_KEY_SECRET_NAME=AI_API_KEY
EMAIL_PROVIDER_KEY_SECRET_NAME=EMAIL_PROVIDER_KEY
